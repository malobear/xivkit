{#- Small line icons for the plugin pages. Decorative only (aria-hidden), drawn on a 24px grid
    with the current text colour, so they follow the theme. -#}
{% macro icon(name, cls) -%}
<svg class="ico{% if cls %} {{ cls }}{% endif %}" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
{%- if name == "user" %}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>
{%- elif name == "download" %}<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>
{%- elif name == "clock" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == "folder" %}<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
{%- elif name == "check" %}<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>
{%- elif name == "alert" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v6"/><path d="M12 17h.01"/>
{%- elif name == "plug" %}<path d="M9 3v5"/><path d="M15 3v5"/><path d="M6 8h12v3a6 6 0 0 1-12 0z"/><path d="M12 17v4"/>
{%- elif name == "box" %}<path d="m3 7 9-4 9 4-9 4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/>
{%- elif name == "code" %}<path d="m8 7-5 5 5 5"/><path d="m16 7 5 5-5 5"/>
{%- elif name == "tag" %}<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/>
{%- elif name == "info" %}<circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><path d="M12 7h.01"/>
{%- elif name == "terminal" %}<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3"/><path d="M13 15h4"/>
{%- elif name == "grid" %}<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
{%- elif name == "image" %}<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>
{%- elif name == "list" %}<path d="M9 6h11"/><path d="M9 12h11"/><path d="M9 18h11"/><path d="M4 6h.01"/><path d="M4 12h.01"/><path d="M4 18h.01"/>
{%- endif %}</svg>
{%- endmacro %}
