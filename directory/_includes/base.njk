<!doctype html>
<html lang="en">
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-DQ3SSXDSFK"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-DQ3SSXDSFK');
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ site.origin }}{{ site.base }}{{ canonicalPath }}">
{% if not site.indexable %}<meta name="robots" content="noindex">
{% endif %}<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="theme-color" content="#0c0b0e" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f7f5f8" media="(prefers-color-scheme: light)">

<meta property="og:type" content="website">
<meta property="og:site_name" content="XIVKit">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.origin }}{{ site.base }}{{ canonicalPath }}">
<meta property="og:image" content="{{ site.origin }}/og-plugins.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ site.origin }}/og-plugins.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="/brand.css">
<link rel="stylesheet" href="/plugins/directory.css">
</head>
<body>
<div class="wrap">
  <nav class="site-nav">
    <a class="wordmark" href="/" aria-label="XIVKit home">XIV<b>KIT</b></a>
    <a href="/">Tools I use</a>
    <a href="/watchlist.html">Watchlist</a>
    <a href="/plugins.html">My plugins</a>
    <a href="/plugins/" aria-current="{{ 'page' if isIndex else 'false' }}">Plugin directory</a>
  </nav>

  {{ content | safe }}

  <footer class="site-footer">
    <p>Plugin data comes from Dalamud's official plugin list, last refreshed {{ meta.fetched }}. Plugins on Dalamud's banned list are left out.</p>
    <p>Plugins are third-party client tools. They are not made, supported or endorsed by Square Enix, and using them is at your own risk. Anything that automates gameplay can break the game's Terms of Service.</p>
    <p>Source on <a href="https://github.com/malobear/xivkit" target="_blank" rel="noopener noreferrer">GitHub</a>. See the <a href="/">main list</a> for the rest of the tools I use.</p>
    <p class="legal">FINAL FANTASY XIV is a registered trademark of Square Enix Holdings Co., Ltd. This is an unofficial, fan-made directory, not affiliated with or endorsed by Square Enix.</p>
  </footer>
</div>
<script src="/plugins/directory.js"></script>
</body>
</html>
