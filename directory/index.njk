---
layout: base.njk
permalink: /index.html
eleventyComputed:
  pageTitle: "FFXIV Dalamud Plugin Directory | XIVKit"
  pageDescription: "Browse {{ meta.count }} FFXIV Dalamud plugins by category, with install counts, last-updated dates, and install status for each."
  canonicalPath: ""
  isIndex: true
---
{% from "card.njk" import card, bar, legend %}
<header class="hero">
  <h1>FFXIV plugin directory</h1>
  <p class="lede">Every plugin in Dalamud's official list, plus well-known third-party repositories, sorted into categories you can actually browse. {{ meta.count }} plugins: {{ meta.official }} official, and {{ meta.thirdParty }} third-party ones, marked with a badge (untick Third-party to hide them). Official plugins install straight from the in-game installer.</p>
  <p class="note">Not sure how to install these? In game, type <code>/xlplugins</code>, open All Plugins, and search for the plugin.</p>
</header>

{{ bar(meta, "Search by name, author or tag") }}
<div class="cats" role="group" aria-label="Categories">
  <a class="chip" href="/plugins/">All <span>{{ meta.count }}</span></a>
  {% for c in categories %}<a class="chip" href="/plugins/category/{{ c.slug }}/">{{ c.name }} <span>{{ c.count }}</span></a>{% endfor %}
  <a class="chip chip-authors" href="/plugins/authors/">Authors <span>{{ authors.length }}</span></a>
</div>
{{ legend() }}

<section aria-labelledby="all-h">
  <h2 id="all-h">All plugins</h2>
  <p class="sub" id="result-line">{{ meta.count }} plugins, most installed first.</p>
  <ul class="plug-list" data-filter-list>
    {% for p in plugins %}{{ card(p, categories) }}{% endfor %}
  </ul>
  <p class="empty" id="empty" hidden>No plugins match. Try a different search or clear a filter.</p>
</section>
