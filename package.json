{
  "name": "xivkit",
  "private": true,
  "description": "XIVKit static site (xivkit.com). Tooling: OG card generator, data scripts, and the Eleventy-built plugin directory.",
  "type": "module",
  "scripts": {
    "og": "node scripts/og.mjs",
    "ventures": "node scripts/ventures.mjs",
    "snapshot": "node scripts/guide-snapshot.mjs",
    "related": "node scripts/related-guides.mjs",
    "updated": "node scripts/guide-updated.mjs",
    "msq": "node scripts/msq.mjs",
    "plugins:fetch": "node scripts/plugins-fetch.mjs",
    "plugins:build": "node -e \"require('fs').rmSync('plugins',{recursive:true,force:true})\" && eleventy",
    "plugins": "pnpm plugins:fetch && pnpm plugins:build",
    "i18n": "node scripts/static-bars.mjs && node scripts/i18n-build.mjs",
    "i18n:check": "node scripts/static-bars.mjs --check && node scripts/i18n-build.mjs --check",
    "currencies": "node scripts/currency-shops.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "linkedom": "^0.18.15",
    "playwright": "^1.56.1"
  }
}
