{% macro card(p, cats) %}
<li class="plug" data-q="{{ (p.name + ' ' + p.punchline + ' ' + p.author + ' ' + p.tags | join(' ')) | lower }}">
  <a class="plug-link" href="{{ '/plugins/' + p.slug + '/' }}">
    {% if p.iconUrl %}<img class="plug-icon" src="{{ p.iconUrl }}" alt="" width="44" height="44" loading="lazy" decoding="async" onerror="this.hidden=true;this.nextElementSibling.hidden=false">{% endif %}<span class="plug-icon plug-icon-blank" aria-hidden="true"{% if p.iconUrl %} hidden{% endif %}>{{ p.name | first | upper }}</span>
    <span class="plug-body">
      <span class="plug-name">{{ p.name }}{% if p.pick %} <span class="badge badge-pick">My pick</span>{% endif %}</span>
      <span class="plug-desc">{{ p.punchline | trunc(120) }}</span>
      <span class="plug-meta">
        <span class="chip-static">{{ cats | categoryName(p.category) }}</span>
        <span>{{ p.downloads | compact }} installs</span>
        {% if p.lastUpdate %}<span>Updated {{ p.lastUpdate | isoDate }}</span>{% endif %}
      </span>
    </span>
  </a>
</li>
{% endmacro %}
