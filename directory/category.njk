---
layout: base.njk
pagination:
  data: categories
  size: 1
  alias: cat
permalink: "/category/{{ cat.slug }}/index.html"
eleventyComputed:
  pageTitle: "{{ cat.name }} plugins for FFXIV | XIVKit"
  pageDescription: "{{ cat.count }} FFXIV Dalamud plugins for {{ cat.name | lower }}. {{ cat.blurb }}"
  canonicalPath: "category/{{ cat.slug }}/"
  isIndex: false
---
{% from "card.njk" import card, bar, legend %}
<nav class="crumbs" aria-label="Breadcrumb"><a href="/plugins/">Plugin directory</a> <span aria-hidden="true">/</span> {{ cat.name }}</nav>
<header class="hero">
  <h1>{{ cat.name }} plugins</h1>
  <p class="lede">{{ cat.blurb }}</p>
</header>

{{ bar(meta, "Search {{ cat.name | lower }} plugins") }}
<div class="cats" role="group" aria-label="Categories">
  <a class="chip" href="/plugins/">All <span>{{ meta.count }}</span></a>
  {% for c in categories %}<a class="chip" href="/plugins/category/{{ c.slug }}/"{% if c.slug == cat.slug %} aria-current="page"{% endif %}>{{ c.name }} <span>{{ c.count }}</span></a>{% endfor %}
</div>
{% if plugins | inCategory(cat.slug) | thirdParty | length %}{{ legend() }}{% endif %}

<section aria-label="{{ cat.name }} plugins">
  <p class="sub" id="result-line">{{ cat.count }} plugins, most installed first.</p>
  <ul class="plug-list" data-filter-list>
    {% for p in plugins | inCategory(cat.slug) %}{{ card(p, categories) }}{% endfor %}
  </ul>
  <p class="empty" id="empty" hidden>No plugins match. Try a different search or clear a filter.</p>
</section>
